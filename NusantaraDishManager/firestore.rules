rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Dish Validation
    function isValidDish(data) {
      return data.keys().hasAll(['dishId', 'name', 'type', 'price', 'userId', 'createdAt', 'updatedAt']) &&
             data.dishId is string && data.dishId.size() <= 50 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 50 &&
             data.price is number && data.price >= 0 &&
             data.userId == request.auth.uid &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidDishUpdate(data) {
      return data.dishId is string &&
             data.name is string &&
             data.type is string &&
             data.price is number &&
             data.updatedAt == request.time;
    }

    match /dishes/{dishId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidId(dishId) && 
                      isValidDish(incoming());
                      
      allow update: if isSignedIn() && 
                      isOwner(existing().userId) && 
                      isValidDishUpdate(incoming()) &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'price', 'ingredients', 'introduction', 'photoUrl', 'updatedAt']);
                      
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
